PORT=3001
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=https://wiuufljcjuudephpheiw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Must match HMAC_QR_SECRET in gym_frontend — generate with: openssl rand -base64 32
HMAC_QR_SECRET=change_me_to_a_long_random_secret_32_chars_min

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret — from https://dashboard.stripe.com/webhooks
# Run: stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Connection string (Supabase Dashboard → Settings → Database → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Shared secret between the Next.js server and the NestJS backend. Must be the
# same value in gym_backend/.env and gym_frontend/.env.local.
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=change_me_to_a_long_random_secret
